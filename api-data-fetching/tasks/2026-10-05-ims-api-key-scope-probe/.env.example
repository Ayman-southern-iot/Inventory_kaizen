# Copy these names into the REPO-ROOT .env file (gitignored). Never commit real values.
# Empty value = that key type is skipped by probe.mjs.

# Optional; defaults to https://ims.siot.solutions
IMS_BASE_URL=https://ims.siot.solutions

# One slot per key type. Issue each in the IMS "Issue key" form.

# Inventory (scope inventory:read)
IMS_KEY_INVENTORY_READ=
# Catalogue (scope catalog:write)
IMS_KEY_CATALOG_WRITE=
# Storage locations (scope locations:write)
IMS_KEY_LOCATIONS_WRITE=
# Receive stock (scope stock:receive)
IMS_KEY_STOCK_RECEIVE=
# Take stock (scope stock:take)
IMS_KEY_STOCK_TAKE=
