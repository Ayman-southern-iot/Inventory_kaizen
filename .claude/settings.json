{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*service_account*.json)",
      "Read(./**/*credential*.json)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard *)",
      "PowerShell(git add .)",
      "PowerShell(git add -A)",
      "PowerShell(git add -A *)",
      "PowerShell(git add --all)",
      "PowerShell(git add --all *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(git commit * -n *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks ; echo \"Inventory_kaizen: git hooks enabled (secret scan, validation, commit format). Commits will be authored as:\" ; git config user.name ; git config user.email ; echo \"Read CLAUDE.md rules before writing anything. Confirm this identity with the user before the first commit.\""
          }
        ]
      }
    ]
  }
}
