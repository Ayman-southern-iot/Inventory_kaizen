# ---- Secrets: NEVER commit. Live Wi-Fi password, IMS key and speech tokens. ----
.env
.env.*
!.env.example

# ---- Build output: 403 MB, 2692 files, fully regenerable by `idf.py build` ----
build/

# ---- Managed components: 292 MB, 9742 files. Regenerated by the IDF component
#      manager from main/idf_component.yml + dependencies.lock, both committed, so
#      exact versions are reproducible without carrying the payload. ----
managed_components/

# ---- Generated sdkconfig. Deliberately NOT committed under its real name: an
#      existing sdkconfig OVERRIDES sdkconfig.defaults, so shipping one would make
#      every later change to the defaults silently do nothing. That trap cost three
#      debugging sessions here. The resolved values are kept for reference as
#      firmware/sdkconfig.generated-reference instead. ----
sdkconfig
sdkconfig.old

# ---- Python / editors / OS ----
__pycache__/
*.pyc
.DS_Store
