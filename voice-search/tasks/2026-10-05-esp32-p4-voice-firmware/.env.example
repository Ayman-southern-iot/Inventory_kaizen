# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#   python tools/provision_nvs.py --port /dev/cu.usbmodem1101
#
# provision_nvs.py writes these into the board's NVS partition. They are never
# compiled into the firmware, never written to sdkconfig (which IS committed via
# sdkconfig.defaults), and never printed in full to the serial log.
#
# NOTE: a key on the board is extractable unless ESP-IDF flash encryption is enabled.
# Treat these as exposed if a board goes missing, and have them revoked.

# --- Wi-Fi (the onboard ESP32-C6 is 2.4 GHz ONLY; a 5 GHz-only SSID is invisible) ---
WIFI_SSID=
WIFI_PASSWORD=

# --- IMS inventory API ---
INVENTORY_BASE_URL=https://ims.siot.solutions
# Read-only key, scope inventory:read. Starts with ims_
IMS_KEY_INVENTORY_READ=

# --- Speech service (Whisper STT / Piper TTS on the infra VM) ---
# Token for the OpenAI-compatible /v1/audio/transcriptions layer. Starts with vs_
VOICE_TOKEN_OPENAI=
# Token for the native /stt + /tts layer, if still in use
VOICE_TOKEN=
